TRADINGBOT_MODE=fixture
TRADINGBOT_DATABASE_URL=sqlite:///.research/research.db
TRADINGBOT_OPENAI_API_KEY=
TRADINGBOT_RESEARCH_MODEL=
TRADINGBOT_PM_MODEL=
# Optional cheaper model for discovery triage; empty uses the research model.
TRADINGBOT_TRIAGE_MODEL=
# Optional reasoning.effort per role (none/minimal/low/medium/high/xhigh, model-dependent).
# Empty keeps the provider default.
TRADINGBOT_RESEARCH_REASONING_EFFORT=
TRADINGBOT_PM_REASONING_EFFORT=
TRADINGBOT_TRIAGE_REASONING_EFFORT=
TRADINGBOT_TOSS_CLIENT_ID=
TRADINGBOT_TOSS_CLIENT_SECRET=
TRADINGBOT_TOSS_ACCOUNT_SEQ=
# Web search provider: tavily (free 1,000 credits/month, no card) or brave (card, metered).
TRADINGBOT_SEARCH_PROVIDER=tavily
TRADINGBOT_TAVILY_API_KEY=
TRADINGBOT_BRAVE_API_KEY=
# Live searches allowed in any rolling 30 days; empty removes the local cap.
TRADINGBOT_SEARCH_MONTHLY_LIMIT=900
# USD holdings in the Toss account are watched and researched automatically.
TRADINGBOT_HOLDINGS_AUTO_WATCH=true
# Research mode for auto-watched holdings (quick/normal/deep/critical); runs daily per holding.
TRADINGBOT_HOLDING_RESEARCH_MODE=quick
# Routine re-research: market_open = each trading day at the US regular open + offset minutes
# (fresh regular-session quotes validate stop levels); interval = every N hours.
TRADINGBOT_RESEARCH_SCHEDULE=market_open
TRADINGBOT_MARKET_OPEN_OFFSET_MINUTES=10
TRADINGBOT_RESEARCH_INTERVAL_HOURS=24
TRADINGBOT_SEC_USER_AGENT=TradingBot contact@example.com
# Optional Chromium fallback: true only with `docker compose --profile browser up -d`.
TRADINGBOT_BROWSER_ENABLED=false
TRADINGBOT_BROWSER_URL=http://browser-worker:8001
TRADINGBOT_BROWSER_TOKEN=
# Browser is read-only (GET/HEAD). Exact hostnames that may receive POST search forms, if any.
TRADINGBOT_BROWSER_POST_ALLOWED_HOSTS=
TRADINGBOT_DISCORD_WEBHOOK=
TRADINGBOT_EGRESS_PROXY=
TRADINGBOT_POSTGRES_PASSWORD=
TRADINGBOT_DISCOVERY_ENABLED=false
TRADINGBOT_DISCOVERY_BATCH=5
TRADINGBOT_BENCHMARK_TICKER=SPY
TRADINGBOT_RETAIN_BROWSER_SCREENSHOTS=false
# Full text is persisted only for these permitted original sources; extend after checking terms.
TRADINGBOT_RETAINED_DOCUMENT_HOSTS=["www.sec.gov","sec.gov","data.sec.gov","www.federalreserve.gov","www.bls.gov","www.bea.gov"]
# Risk inputs must be supplied in research requests; none are invented here.
